{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hangglidersrule.dev/contracts/darkstar-release/v1/ledger.schema.json",
  "title": "Darkstar four-product publication-readiness ledger",
  "description": "Machine-readable, per-family source of truth for the immutable Darkstar four-product release process. Statuses are rendered into model matrices and model cards; there is no separate gap report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "contract_version",
    "family",
    "source_revision",
    "any_publication_claim",
    "products",
    "rejected_historical",
    "related_issues"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "contract": {"type": "string"},
    "contract_version": {"type": "string"},
    "family": {"type": "string"},
    "family_display": {"type": "string"},
    "source_revision": {"type": "string"},
    "note": {"type": "string"},
    "any_publication_claim": {"type": "boolean"},
    "products": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/product"}
    },
    "rejected_historical": {
      "type": "array",
      "items": {"$ref": "#/$defs/rejected_historical_entry"}
    },
    "related_issues": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["verified", "in_progress", "missing", "rejected_historical", "not_applicable"]
    },
    "role": {
      "type": "string",
      "enum": ["base-bf16", "base-modelopt-nvfp4", "abliterated-bf16", "abliterated-modelopt-nvfp4"]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence", "evidence_path", "next_missing_proof"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "status": {"$ref": "#/$defs/status"},
        "evidence": {"type": "string", "pattern": "^[^|\\n]*$"},
        "evidence_path": {"type": ["string", "null"]},
        "next_missing_proof": {"type": "string", "pattern": "^[^|\\n]*$"}
      }
    },
    "precision_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language_mlp",
        "lm_head",
        "self_attention",
        "gdn_projections",
        "kv_cache",
        "protected"
      ],
      "properties": {
        "language_mlp": {"type": "string"},
        "lm_head": {"type": "string"},
        "self_attention": {"type": "string"},
        "gdn_projections": {"type": "string"},
        "kv_cache": {"type": "string"},
        "protected": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "precision_class",
        "target_repository",
        "selection",
        "recipe",
        "precision_map"
      ],
      "properties": {
        "candidate_id": {"type": "string"},
        "target_repository": {
          "type": "string",
          "description": "Reserved, precision-encoded repository id for this candidate: <namespace>/<candidate_id>.",
          "pattern": "^[A-Za-z0-9._-]+/Darkstar-[A-Za-z0-9._-]*ModelOpt-(W4A16|W4A4)-NVFP4(-Mixed-FP8)?$"
        },
        "precision_class": {"type": "string"},
        "selection": {
          "type": "string",
          "enum": ["selected", "rejected", "under_evaluation", "not_built"]
        },
        "promotion_status": {
          "type": "string",
          "enum": ["promoted", "blocked", "none"]
        },
        "promotion_note": {"type": "string"},
        "recipe": {"type": ["string", "null"]},
        "evidence_path": {"type": ["string", "null"]},
        "immutable_hashes": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "gpqa": {"type": "object"},
        "precision_map": {"$ref": "#/$defs/precision_map"}
      },
      "allOf": [{"$ref": "#/$defs/mixed_fp8_naming_derived_from_precision_map"}]
    },
    "mixed_fp8_naming_derived_from_precision_map": {
      "description": "Mixed-FP8 naming is derived from the precision map, not trusted from the declared names: a candidate that serves FP8 on any weight path (language_mlp, lm_head, self_attention, gdn_projections, protected) MUST spell Mixed-FP8 in its precision_class, candidate_id, and reserved target_repository, and a candidate with no FP8 weight path MUST NOT mention FP8 in any of them. kv_cache is deliberately excluded: runtime KV metadata never implies Mixed-FP8.",
      "if": {
        "required": ["precision_map"],
        "properties": {
          "precision_map": {
            "anyOf": [
              {"required": ["language_mlp"], "properties": {"language_mlp": {"pattern": "FP8"}}},
              {"required": ["lm_head"], "properties": {"lm_head": {"pattern": "FP8"}}},
              {"required": ["self_attention"], "properties": {"self_attention": {"pattern": "FP8"}}},
              {"required": ["gdn_projections"], "properties": {"gdn_projections": {"pattern": "FP8"}}},
              {"required": ["protected"], "properties": {"protected": {"pattern": "FP8"}}}
            ]
          }
        }
      },
      "then": {
        "properties": {
          "candidate_id": {"pattern": "-Mixed-FP8$"},
          "precision_class": {"pattern": "-Mixed-FP8$"},
          "target_repository": {"pattern": "-Mixed-FP8$"}
        }
      },
      "else": {
        "properties": {
          "candidate_id": {"not": {"pattern": "FP8"}},
          "precision_class": {"not": {"pattern": "FP8"}},
          "target_repository": {"not": {"pattern": "FP8"}}
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "role",
        "lifecycle",
        "target_repository",
        "target_repository_status",
        "served_model_alias",
        "runtime_container_name",
        "model_card",
        "recipe",
        "publication_claim",
        "gates"
      ],
      "properties": {
        "product_id": {"type": "string"},
        "role": {"$ref": "#/$defs/role"},
        "lifecycle": {
          "type": "string",
          "description": "Where the product sits between build and public release. Must agree with the gate statuses (enforced in src/model_forge/release.py): in_progress while any applicable build gate is open, locally_complete_unpublished when every build gate is verified but a publication-only gate is open, published when every applicable gate is verified.",
          "enum": ["in_progress", "locally_complete_unpublished", "published"]
        },
        "target_repository": {
          "description": "The actual publication target. Null only while target_repository_status is unresolved_pending_precision_winner. A ModelOpt NVFP4 target must encode ModelOpt plus W4A16 or W4A4 (plus Mixed-FP8 when applicable); a bare NVFP4 target is forbidden.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^(Qwen/Qwen3\\.8-27B|[A-Za-z0-9._-]+/Darkstar-[A-Za-z0-9.-]*(BF16|ModelOpt-(W4A16|W4A4)-NVFP4(-Mixed-FP8)?))$"
            }
          ]
        },
        "target_repository_status": {
          "type": "string",
          "enum": ["resolved", "unresolved_pending_precision_winner"]
        },
        "target_repository_note": {"type": "string"},
        "served_model_alias": {
          "type": "string",
          "description": "Concise lowercase runtime API identity; distinct from the precision-encoded publication repository.",
          "pattern": "^darkstar-[a-z0-9]+-(base|abliterated)-(bf16|nvfp4)$"
        },
        "runtime_container_name": {
          "type": "string",
          "pattern": "^vllm-darkstar-[a-z0-9]+-(base|abliterated)-(bf16|modelopt)$"
        },
        "serve_compose": {
          "type": "string",
          "pattern": "^containers/serve/darkstar-[a-z0-9]+-(base|abliterated)-(bf16|nvfp4)\\.yml$"
        },
        "model_card": {"type": "string"},
        "recipe": {"type": ["string", "null"]},
        "publication_claim": {"type": "boolean"},
        "candidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate"}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gate"}
        }
      }
    },
    "rejected_historical_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "reason"],
      "properties": {
        "item": {"type": "string"},
        "reason": {"type": "string"},
        "evidence_path": {"type": ["string", "null"]}
      }
    }
  }
}
