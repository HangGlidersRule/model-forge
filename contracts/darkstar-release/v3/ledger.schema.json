{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://hangglidersrule.dev/contracts/darkstar-release/v3/ledger.schema.json",
 "title": "Darkstar publication-readiness ledger (v3)",
 "description": "Machine-readable, per-family source of truth for the Darkstar release process. v3 allows several products in one role (4 to 16). Statuses are rendered into model matrices and model cards; there is no separate gap report.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "contract",
  "contract_version",
  "family",
  "source_revision",
  "any_publication_claim",
  "products",
  "rejected_historical",
  "related_issues"
 ],
 "properties": {
  "schema_version": {
   "type": "string"
  },
  "contract": {
   "type": "string"
  },
  "contract_version": {
   "type": "string"
  },
  "family": {
   "type": "string"
  },
  "family_display": {
   "type": "string"
  },
  "source_revision": {
   "type": "string"
  },
  "note": {
   "type": "string"
  },
  "any_publication_claim": {
   "type": "boolean"
  },
  "products": {
   "type": "array",
   "minItems": 4,
   "maxItems": 16,
   "items": {
    "$ref": "#/$defs/product"
   },
   "description": "At least four products and at most sixteen. A role may appear more than once. product_id, resolved target_repository, served_model_alias, and runtime_container_name are unique within the ledger (enforced in src/model_forge/release.py)."
  },
  "rejected_historical": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/rejected_historical_entry"
   }
  },
  "related_issues": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "$defs": {
  "status": {
   "type": "string",
   "enum": [
    "verified",
    "in_progress",
    "missing",
    "rejected_historical",
    "not_applicable"
   ]
  },
  "role": {
   "type": "string",
   "enum": [
    "base-bf16",
    "base-modelopt-nvfp4",
    "abliterated-bf16",
    "abliterated-modelopt-nvfp4",
    "image-base-bf16",
    "image-base-nvfp4",
    "image-base-fp8",
    "image-abliterated-bf16",
    "image-abliterated-nvfp4"
   ]
  },
  "gate": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "status",
    "evidence",
    "evidence_path",
    "next_missing_proof"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9_]+$"
    },
    "status": {
     "$ref": "#/$defs/status"
    },
    "evidence": {
     "type": "string",
     "pattern": "^[^|\\n]*$"
    },
    "evidence_path": {
     "type": [
      "string",
      "null"
     ]
    },
    "next_missing_proof": {
     "type": "string",
     "pattern": "^[^|\\n]*$"
    },
    "metric": {
     "type": "string",
     "minLength": 1
    },
    "protocol": {
     "type": "string",
     "minLength": 1
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "id": {
        "const": "quality_matched_full_denominator"
       }
      },
      "required": [
       "id"
      ]
     },
     "then": {
      "required": [
       "metric",
       "protocol"
      ]
     }
    }
   ]
  },
  "precision_map": {
   "anyOf": [
    {
     "$ref": "#/$defs/precision_map_text"
    },
    {
     "$ref": "#/$defs/precision_map_diffusion"
    }
   ]
  },
  "candidate": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "candidate_id",
    "precision_class",
    "target_repository",
    "selection",
    "recipe",
    "precision_map"
   ],
   "properties": {
    "candidate_id": {
     "type": "string"
    },
    "target_repository": {
     "type": "string",
     "description": "Reserved, precision-encoded repository id for this candidate: <namespace>/<candidate_id>.",
     "pattern": "^[A-Za-z0-9._-]+/Darkstar-[A-Za-z0-9._-]*ModelOpt-(W4A16|W4A4)-NVFP4(-Mixed-FP8)?$"
    },
    "precision_class": {
     "type": "string"
    },
    "selection": {
     "type": "string",
     "enum": [
      "selected",
      "rejected",
      "under_evaluation",
      "not_built"
     ]
    },
    "promotion_status": {
     "type": "string",
     "enum": [
      "promoted",
      "blocked",
      "none"
     ]
    },
    "promotion_note": {
     "type": "string"
    },
    "recipe": {
     "type": [
      "string",
      "null"
     ]
    },
    "evidence_path": {
     "type": [
      "string",
      "null"
     ]
    },
    "immutable_hashes": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "gpqa": {
     "type": "object"
    },
    "precision_map": {
     "$ref": "#/$defs/precision_map"
    },
    "architecture": {
     "type": "string",
     "enum": [
      "text",
      "diffusion"
     ],
     "description": "Optional; absent means text (causal LM). Diffusion candidates must declare 'diffusion' explicitly."
    }
   },
   "allOf": [
    {
     "$ref": "#/$defs/mixed_fp8_naming_derived_from_precision_map"
    }
   ]
  },
  "mixed_fp8_naming_derived_from_precision_map": {
   "description": "Mixed-FP8 naming is derived from the precision map, not trusted from the declared names: a candidate that serves FP8 on any weight path (language_mlp, lm_head, self_attention, gdn_projections, protected) MUST spell Mixed-FP8 in its precision_class, candidate_id, and reserved target_repository, and a candidate with no FP8 weight path MUST NOT mention FP8 in any of them. kv_cache is deliberately excluded: runtime KV metadata never implies Mixed-FP8.",
   "if": {
    "required": [
     "precision_map"
    ],
    "properties": {
     "precision_map": {
      "anyOf": [
       {
        "required": [
         "language_mlp"
        ],
        "properties": {
         "language_mlp": {
          "pattern": "FP8"
         }
        }
       },
       {
        "required": [
         "lm_head"
        ],
        "properties": {
         "lm_head": {
          "pattern": "FP8"
         }
        }
       },
       {
        "required": [
         "self_attention"
        ],
        "properties": {
         "self_attention": {
          "pattern": "FP8"
         }
        }
       },
       {
        "required": [
         "gdn_projections"
        ],
        "properties": {
         "gdn_projections": {
          "pattern": "FP8"
         }
        }
       },
       {
        "required": [
         "protected"
        ],
        "properties": {
         "protected": {
          "pattern": "FP8"
         }
        }
       }
      ]
     }
    }
   },
   "then": {
    "properties": {
     "candidate_id": {
      "pattern": "-Mixed-FP8$"
     },
     "precision_class": {
      "pattern": "-Mixed-FP8$"
     },
     "target_repository": {
      "pattern": "-Mixed-FP8$"
     }
    }
   },
   "else": {
    "properties": {
     "candidate_id": {
      "not": {
       "pattern": "FP8"
      }
     },
     "precision_class": {
      "not": {
       "pattern": "FP8"
      }
     },
     "target_repository": {
      "not": {
       "pattern": "FP8"
      }
     }
    }
   }
  },
  "product": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "product_id",
    "role",
    "task",
    "lifecycle",
    "target_repository",
    "target_repository_status",
    "served_model_alias",
    "runtime_container_name",
    "model_card",
    "recipe",
    "publication_claim",
    "gates"
   ],
   "properties": {
    "product_id": {
     "type": "string"
    },
    "role": {
     "$ref": "#/$defs/role"
    },
    "lifecycle": {
     "type": "string",
     "description": "Where the product sits between build and public release. Must agree with the gate statuses (enforced in src/model_forge/release.py): in_progress while any applicable build gate is open, locally_complete_unpublished when every build gate is verified but a publication-only gate is open, published when every applicable gate is verified.",
     "enum": [
      "in_progress",
      "locally_complete_unpublished",
      "published"
     ]
    },
    "target_repository": {
     "description": "The actual publication target. Null only while target_repository_status is unresolved_pending_precision_winner. A ModelOpt NVFP4 target must encode ModelOpt plus W4A16 or W4A4 (plus Mixed-FP8 when applicable); a bare NVFP4 target is forbidden.",
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "string",
       "pattern": "^(Qwen/Qwen3\\.8-27B|Qwen/Qwen-Image-2\\.1|Qwen/Qwen3-Embedding-8B|Qwen/Qwen3-Reranker-4B|nvidia/NVIDIA-Nemotron-3\\.5-Lightning-30B-A3B-BF16|nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-BF16|[A-Za-z0-9._-]+/Darkstar-[A-Za-z0-9.-]*(BF16|ModelOpt-(W4A16|W4A4)-NVFP4(-Mixed-FP8)?))$",
       "description": "The actual publication target. Null only while target_repository_status is unresolved_pending_precision_winner. A ModelOpt NVFP4 target must encode ModelOpt plus W4A16 or W4A4 (plus Mixed-FP8 when applicable); a bare NVFP4 target is forbidden. base-bf16 and image-base-bf16 may name an unchanged upstream reference listed in the pattern."
      },
      {
       "type": "string",
       "pattern": "^[A-Za-z0-9._-]+/Darkstar-(?!.*W4A)[A-Za-z0-9.-]*(NVFP4(-Mixed-FP8)?|FP8)$",
       "description": "v2 diffusion targets: precision vocabulary NVFP4 / FP8 / Mixed-FP8 without W4Axx encoding."
      }
     ]
    },
    "target_repository_status": {
     "type": "string",
     "enum": [
      "resolved",
      "unresolved_pending_precision_winner"
     ]
    },
    "target_repository_note": {
     "type": "string"
    },
    "served_model_alias": {
     "type": "string",
     "description": "Concise lowercase runtime API identity; family token is alnum-only (image families use e.g. qwenimage21).",
     "pattern": "^darkstar-[a-z0-9]+-(base|abliterated)-(bf16|nvfp4|fp8)$"
    },
    "runtime_container_name": {
     "type": "string",
     "pattern": "^vllm-darkstar-[a-z0-9]+-(base|abliterated)-(bf16|modelopt|nvfp4|fp8)$",
     "description": " v2: nvfp4 suffix allowed for image runtime containers."
    },
    "serve_compose": {
     "type": "string",
     "pattern": "^containers/serve/darkstar-[a-z0-9]+-(base|abliterated)-(bf16|nvfp4|fp8)\\.yml$"
    },
    "model_card": {
     "type": "string"
    },
    "recipe": {
     "type": [
      "string",
      "null"
     ]
    },
    "publication_claim": {
     "type": "boolean"
    },
    "candidates": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/candidate"
     }
    },
    "gates": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/gate"
     }
    },
    "task": {
     "type": "string",
     "enum": [
      "chat",
      "embedding",
      "rerank",
      "decision",
      "image"
     ],
     "description": "Family task. Selects which matched full-denominator quality gate is required."
    }
   }
  },
  "rejected_historical_entry": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "item",
    "reason"
   ],
   "properties": {
    "item": {
     "type": "string"
    },
    "reason": {
     "type": "string"
    },
    "evidence_path": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "precision_map_diffusion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "dit_blocks",
    "protected_blocks",
    "attention",
    "text_encoder",
    "vae"
   ],
   "properties": {
    "dit_blocks": {
     "type": "string"
    },
    "protected_blocks": {
     "type": "string"
    },
    "attention": {
     "type": "string"
    },
    "text_encoder": {
     "type": "string"
    },
    "vae": {
     "type": "string"
    }
   }
  },
  "precision_map_text": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "language_mlp",
    "lm_head",
    "self_attention",
    "gdn_projections",
    "kv_cache",
    "protected"
   ],
   "properties": {
    "language_mlp": {
     "type": "string"
    },
    "lm_head": {
     "type": "string"
    },
    "self_attention": {
     "type": "string"
    },
    "gdn_projections": {
     "type": "string"
    },
    "kv_cache": {
     "type": "string"
    },
    "protected": {
     "type": "string"
    }
   }
  }
 }
}
