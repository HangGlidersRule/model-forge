+# MoE layers run sequentially, so identically-shaped B12xMoEWrappers can share
+# one set of workspaces and output buffer: the first wrapper per shape owns
+# them and the rest borrow. Weak values free them together with the model.
+_buffer_owners: weakref.WeakValueDictionary[tuple, Any] = weakref.WeakValueDictionary()
+
+
+def _b12x_buffer_key(
+    *,
+    num_experts: int,
+    top_k: int,
+    hidden_size: int,
+    intermediate_size: int,
+    max_num_tokens: int,
+    num_local_experts: int,
+    activation: str,
+    quant_mode: str,
+    out_dtype: torch.dtype,
+    device_index: int,
+) -> tuple:
+    """Key under which B12xMoEWrappers may share workspaces.
+
+    ``intermediate_size`` must be the padded size the wrapper is built with
+    (see ``_resolve_padded_intermediate_size``): FlashInfer does not validate
+    a shared dynamic workspace against the wrapper's shape, so a key on the
+    configured size would let differently-padded layers alias undersized
+    buffers.
+    """
+    return (
+        num_experts,
+        top_k,
+        hidden_size,
+        intermediate_size,
+        max_num_tokens,
+        num_local_experts,
+        activation,
+        quant_mode,
+        out_dtype,
+        device_index,
+    )
+
+
+def _resolve_padded_intermediate_size(
+    configured_intermediate_size: int,
+    is_gated: bool,
+    w13_weight: torch.Tensor,
+) -> int:
+    """Return the intermediate size actually present in the prepared FC1
+    weight, which can be wider than ``configured_intermediate_size``.
+
+    vLLM's non-gated NVFP4 b12x weight-prep path
+    (``prepare_nvfp4_moe_layer_for_b12x`` in
+    ``vllm/model_executor/layers/quantization/utils/b12x_moe.py``) swizzles
+    ``w13_scale``, which rounds the row count up to a multiple of 128, then
+    pads ``w13`` rows (and ``w2`` / ``w2_scale`` columns) to match. The
+    padded channels are zero, so the padded width is numerically equivalent
+    to the original -- but ``B12xMoEWrapper`` must be constructed with that
+    padded width. Otherwise it still treats ``n`` as the original, smaller
+    ``intermediate_size_per_partition`` and re-pads scale tensors that are
+    already padded, which corrupts FlashInfer's MMA-layout reshape
+    (``_pad_intermediate_to_tile`` -> ``convert_sf_from_mma_layout``).
+
+    When the configured size is already a multiple of 128, vLLM performs no
+    padding and this returns the input unchanged. Gated models are padded to
+    a different (64-row) boundary upstream by a separate, already-correct
+    code path and are intentionally left untouched here.
+    """
+    if is_gated:
+        return configured_intermediate_size
+    return w13_weight.shape[1]
+
 
